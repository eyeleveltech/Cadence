# ── Database ──────────────────────────────────────────────
# Local dev matches docker-compose.yml. Production uses .env.production
# with real credentials — never commit that file.
DATABASE_URL="postgresql://cadence:cadence_dev_password@localhost:5432/cadence"

# ── Redis (BullMQ) ────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Better Auth ───────────────────────────────────────────
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# ── Encryption for stored platform tokens ────────────────
# Social account access/refresh tokens are encrypted at the application
# layer before they ever reach Postgres. Generate with:
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# ── Media storage ─────────────────────────────────────────
# Where uploads are written by the local-disk adapter. Deliberately
# outside public/ — files are served by /api/media, which checks the
# caller can reach the client first. Defaults to ./var/media.
MEDIA_ROOT=""

# ── Media storage (Cloudinary) ───────────────────────────
# lib/storage.ts switches to Cloudinary automatically when these are set,
# and falls back to local disk when they aren't. Either CLOUDINARY_URL on
# its own, or the three separate values.
# Cloudinary serves public URLs, which is what Meta needs: it fetches
# image_url server-side at publish time and cannot authenticate, so it
# can't read the /api/media route.
CLOUDINARY_URL=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Media storage (Cloudflare R2 — S3-compatible) ────────
# Optional / Planned: reserved for future Cloudflare R2 object storage migration.
# The application currently stores uploads using either local disk (MEDIA_ROOT)
# or Cloudinary (CLOUDINARY_*).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="cadence-media"
R2_PUBLIC_URL=""

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Cadence <noreply@theeyelevelstudio.com>"

# ── Meta (Instagram via Facebook Page + Facebook) ────────
# Instagram API with Facebook Login: reaches Instagram through a linked
# Facebook Page. App settings -> Basic in the Meta app dashboard.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v22.0"
# Configurable Meta OAuth Scopes (comma-separated). Defaults to full production scopes if unset.
# META_OAUTH_SCOPES="pages_show_list,pages_read_engagement,pages_manage_posts,business_management,public_profile"
META_OAUTH_SCOPES=""
FACEBOOK_OAUTH_SCOPES=""

# ── Instagram (direct login, no Facebook Page needed) ────
# Instagram API with Instagram Login. These are the *Instagram* app id
# and secret from the dashboard's Instagram section — different values
# from META_APP_ID/META_APP_SECRET, even inside the same app.
# Use this route for a client whose Instagram isn't linked to a Page.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""

# ── LinkedIn ──────────────────────────────────────────────
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ── YouTube / Google ──────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── X / Twitter ───────────────────────────────────────────
# OAuth 2.0 with PKCE (RFC 7636 S256). App credentials from the
# Twitter Developer Portal (developer.twitter.com).
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# ── Social Development Simulation ─────────────────────────
# Set to "1" to simulate social publishing and analytics metrics locally
# without needing live OAuth developer credentials or external API calls.
SOCIAL_DEV_SIMULATE="0"

# ── Video Processing (FFmpeg) ─────────────────────────────
# Optional: Path to the ffmpeg executable for 9:16 vertical transcoding
# and video poster frame generation. If left empty, Cadence attempts to
# resolve "ffmpeg" from the system PATH or @ffmpeg-installer/ffmpeg.
# If FFmpeg is not installed, video processing falls back gracefully.
FFMPEG_PATH=""

# ── Observability ─────────────────────────────────────────
# DSNs aren't secret — safe to expose client-side. Everything below is a
# no-op until set; see instrumentation.ts / instrumentation-client.ts.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only needed to upload source maps at build time — safe to leave unset.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ── App ───────────────────────────────────────────────────
NODE_ENV="development"

# ── Seeding (local only) ──────────────────────────────────
# prisma/seed.ts refuses to run with NODE_ENV=production, or against a
# non-local DATABASE_URL unless SEED_ALLOW_REMOTE is set. Override the
# committed dev password on a shared box.
SEED_PASSWORD=""
